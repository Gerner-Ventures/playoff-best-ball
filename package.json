{
  "name": "playoff-best-ball",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "db:migrate": "dotenv -e .env -- prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:push": "dotenv -e .env -- prisma db push",
    "db:push:test": "dotenv -e .env.test -- prisma db push",
    "db:seed:players": "dotenv -e .env -- tsx prisma/seed-players-cli.ts",
    "db:seed:players:test": "dotenv -e .env.test -- tsx prisma/seed-players-cli.ts",
    "db:status": "dotenv -e .env -- prisma migrate status",
    "dev": "next dev",
    "lint": "eslint",
    "demo:capture": "dotenv -e .env -- tsx scripts/capture-season.ts",
    "demo:seed": "dotenv -e .env -- tsx scripts/demo-seed.ts",
    "mock:week": "dotenv -e .env -- tsx scripts/mock-week.ts",
    "postinstall": "prisma generate",
    "start": "next start",
    "test": "dotenv -e .env.test -- vitest run",
    "test:e2e": "playwright test",
    "test:watch": "dotenv -e .env.test -- vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.2",
    "inngest": "^4.18.1",
    "nanoid": "^6.0.1",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "posthog-js": "^1.421.0",
    "posthog-node": "^5.51.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.24.0",
    "stripe": "^22.5.0",
    "twilio": "^6.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24 <26",
    "npm": ">=11"
  }
}
